#!/bin/bash --login
#SBATCH --job-name=meoh_FIO_RBS_split
#SBATCH --chdir=/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia
#SBATCH --output=slurm_logs/meoh_FIO_RBS_split_%A_%a.out
#SBATCH --array=0-2
#SBATCH --time=8-08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --mem=120G
#SBATCH --partition=bigmem
#SBATCH --mail-type=fail
#SBATCH --mail-user=m.qureshi.1@campus.tu-berlin.de

# One array task per noise level, replacing the single job that ran all three
# as spawned workers sharing 12 cores.
#
# The cost is dominated by the parameter fit, whose residual loop in
# src/optimizer.jl threads over Nexps. Nexps grows to 100, so that loop can use
# far more than the 4 threads each worker had before. Giving one noise level a
# whole 20-core node runs it 20-way instead, on the part that actually costs.
#
# The three tasks share SLURM_ARRAY_JOB_ID, so the script puts them in one
# results folder, each writing its own noise_<level> subfolder and its own
# progress file. tools/snapshot_progress.py reads the folder and compares them.
#
# Nothing about the method changes: the BO loop stays strictly sequential, and
# the noise levels were always independent of each other.
#
# This one also spends heavily on the information objective, which builds a
# central-difference Jacobian over all 9 parameters per candidate. That loop is
# still serial inside the process, so it benefits from the extra threads only
# through the Julia solves it calls.

export JULIA_DEPOT_PATH="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.julia_depot"
export PYTHON_JULIAPKG_EXE="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install/bin/julia"
export PYTHON_JULIAPKG_OFFLINE=yes
export JULIA_PKG_PRECOMPILE_AUTO=0

JULIA_INSTALL="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install"
export LD_LIBRARY_PATH="$JULIA_INSTALL/lib/julia:$JULIA_INSTALL/lib:$LD_LIBRARY_PATH"

# One process now, so Julia takes every core. BLAS is pinned to a single thread
# on purpose: 20 Julia threads each spawning their own BLAS pool would
# oversubscribe the node badly, and the matrices here are small.
export PYTHON_JULIACALL_HANDLE_SIGNALS=yes
export JULIA_NUM_THREADS=20
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg

NOISE_LEVELS=(1e-5 1e-6 1e-7)
NOISE=${NOISE_LEVELS[$SLURM_ARRAY_TASK_ID]}
echo "array task $SLURM_ARRAY_TASK_ID -> noise $NOISE"

"/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/bin/python" \
    "/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/bayes_design_meoh_FIO_RBS.py" \
    --noise "$NOISE"
