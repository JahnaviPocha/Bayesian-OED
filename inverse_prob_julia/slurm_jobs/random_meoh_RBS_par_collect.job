#!/bin/bash --login
#SBATCH --job-name=rand_meoh_par_col
#SBATCH --chdir=/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia
#SBATCH --output=slurm_logs/rand_meoh_par_col_%j.out
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96G   # bigmem QOS floor is 80G, not a real need
#SBATCH --partition=bigmem
#SBATCH --mail-type=end,fail
#SBATCH --mail-user=m.qureshi.1@campus.tu-berlin.de

# Stage 3 of 3: read the checkpoints and write the Excel file, summary and
# plots using the original script's own export and plotting functions.
#
# Safe to run at any point, not just at the end: it plots whatever estimates
# exist and reports how many are missing. Useful for checking progress while
# stage 2 is still going.

export JULIA_DEPOT_PATH="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.julia_depot"
export PYTHON_JULIAPKG_EXE="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install/bin/julia"
export PYTHON_JULIAPKG_OFFLINE=yes
export JULIA_PKG_PRECOMPILE_AUTO=0

JULIA_INSTALL="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install"
export LD_LIBRARY_PATH="$JULIA_INSTALL/lib/julia:$JULIA_INSTALL/lib:$LD_LIBRARY_PATH"

export PYTHON_JULIACALL_HANDLE_SIGNALS=yes
export JULIA_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg

"/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/bin/python" \
    "/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/bayes_design_random_meoh_RBS_parallel.py" \
    --stage collect
