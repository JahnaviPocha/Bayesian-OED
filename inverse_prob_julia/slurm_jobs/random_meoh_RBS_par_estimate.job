#!/bin/bash --login
#SBATCH --job-name=rand_meoh_par_est
#SBATCH --chdir=/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia
#SBATCH --output=slurm_logs/rand_meoh_par_est_%A_%a.out
#SBATCH --array=0-11
#SBATCH --time=8-08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=48G
#SBATCH --partition=bigmem
#SBATCH --mail-type=fail
#SBATCH --mail-user=m.qureshi.1@campus.tu-berlin.de

# Stage 2 of 3: the 273 parameter fits, n = 10..100 for each of 3 noise levels.
#
# 12 array shards x 4 workers = 48 fits at a time. Tasks are dealt largest-n
# first so the expensive tail starts immediately instead of being left until
# the end. Each fit checkpoints on completion, so a shard that dies costs only
# its in-flight work and can be resubmitted as-is.
#
# --time is the bigmem partition maximum (8-08:00:00). The sequential runs only
# asked for 6 days because their scripts said so, not because of any limit.
#
# Measured footprint is ~4 GB per worker, so 48G covers 4 workers with room.

export JULIA_DEPOT_PATH="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.julia_depot"
export PYTHON_JULIAPKG_EXE="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install/bin/julia"
export PYTHON_JULIAPKG_OFFLINE=yes
export JULIA_PKG_PRECOMPILE_AUTO=0

JULIA_INSTALL="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install"
export LD_LIBRARY_PATH="$JULIA_INSTALL/lib/julia:$JULIA_INSTALL/lib:$LD_LIBRARY_PATH"

# src/optimizer.jl threads its residual loop over Nexps, so each fit genuinely
# uses its 4 threads. 4 workers x 4 threads = 16 = --cpus-per-task.
export PYTHON_JULIACALL_HANDLE_SIGNALS=yes
export JULIA_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg

"/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/bin/python" \
    "/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/bayes_design_random_meoh_RBS_parallel.py" \
    --stage estimate
