#!/bin/bash --login
#SBATCH --job-name=rand_meoh_sweep_RBS
#SBATCH --chdir=/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia
#SBATCH --output=slurm_logs/rand_meoh_sweep_RBS_%A_%a.out
#SBATCH --array=0-11
#SBATCH --time=8-08:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --mem=120G
#SBATCH --partition=bigmem
#SBATCH --mail-type=fail
#SBATCH --mail-user=m.qureshi.1@campus.tu-berlin.de

# The random RBS sweep as 423 independent complete_workflow calls,
# 141 experiment counts x 3 noise levels, split over 12 array shards.
#
# Nothing is shared between tasks: complete_workflow builds its own Halton
# design, generates its own data and starts every fit from Par * 0.5. The
# sequential script only ran these in order because each fit warm-started from
# the last, which is the one thing that made the sweep serial.
#
# One process per shard, so Julia gets all 20 cores. Both loops that matter
# thread: the offline snapshot loop over catalyst cells and the residual loop
# over Nexps in src/optimizer.jl. A second process would only split the cores
# and give the shard a second cold offline cache.
#
# Tasks run in ascending Nexps within a shard. The offline cache is keyed on
# the design point and Halton is nested, so a task at Nexps=150 reuses
# everything the smaller counts in the same shard already computed.
#
# BLAS is pinned to one thread; the parallelism that matters is the CFD solves.

export JULIA_DEPOT_PATH="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.julia_depot"
export PYTHON_JULIAPKG_EXE="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install/bin/julia"
export PYTHON_JULIAPKG_OFFLINE=yes
export JULIA_PKG_PRECOMPILE_AUTO=0

JULIA_INSTALL="/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/julia_env/pyjuliapkg/install"
export LD_LIBRARY_PATH="$JULIA_INSTALL/lib/julia:$JULIA_INSTALL/lib:$LD_LIBRARY_PATH"

export PYTHON_JULIACALL_HANDLE_SIGNALS=yes
export JULIA_NUM_THREADS=20
export JULIA_NUM_GC_THREADS=4
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg

"/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/.venv/bin/python" \
    "/net/work/qureshi/mycode/Bayesian-OED/inverse_prob_julia/random_meoh_sweep.py" \
    --stage sweep --shard "$SLURM_ARRAY_TASK_ID" --nshards 12 --rbs-full
